<Window x:Class="HashLynx.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HashLynx · Local password recovery" Width="1380" Height="920" MinWidth="1040" MinHeight="650" Icon="Assets/logo.png" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><DockPanel Margin="16,22,16,20">
      <StackPanel DockPanel.Dock="Top"><Border Background="#E4F3F5" CornerRadius="10" Padding="5" Margin="4,0,4,10"><Image Source="Assets/logo_withText.png" Width="160" Height="106" Stretch="Uniform"/></Border><TextBlock Text="RECOVERY WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,25"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="10,20,4,0"><TextBlock Text="LOCAL BY DEFAULT" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="No uploads. No telemetry." Style="{StaticResource Muted}" Margin="0,5,0,12"/><TextBlock Text="HashLynx 0.1.0" Style="{StaticResource Muted}"/></StackPanel>
      <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="2,6"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="30"/><TextBlock Text="{Binding Name}" FontWeight="Medium"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel></Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,16"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding Services.BackendLabel}" Style="{StaticResource Muted}"/></StackPanel><TextBlock Text="AUTHORIZED RECOVERY &amp; AUDITING" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></DockPanel></Border>
      <DockPanel Grid.Row="1">
        <Border x:Name="CompletionBanner" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="30,16,30,0" Visibility="{Binding CompletionVisible, Converter={StaticResource BoolVisibility}}"><StackPanel>
          <DockPanel><Button Content="Dismiss" DockPanel.Dock="Right" Command="{Binding DismissCompletionCommand}"/><TextBlock Text="{Binding CompletionTitle}" Style="{StaticResource SectionTitle}"/></DockPanel>
          <TextBlock Text="{Binding CompletionDetail}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <WrapPanel><Button Content="View recovered passwords" Command="{Binding OpenCompletionCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding CompletionHasResults, Converter={StaticResource BoolVisibility}}"/><Button Content="View session" Command="{Binding OpenCompletionSessionCommand}"/><Button Content="Choose another attempt" Command="{Binding TryAnotherAttemptCommand}"/></WrapPanel>
        </StackPanel></Border>
        <ContentControl Content="{Binding CurrentPage}"/>
      </DockPanel>
      <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,10"><StackPanel><TextBlock Text="{Binding Services.Notice}" Foreground="{DynamicResource MutedBrush}" FontSize="12" MaxHeight="55" TextTrimming="CharacterEllipsis" ToolTip="{Binding Services.Notice}"/><Expander Header="Diagnostics" FontSize="11" Margin="0,5,0,0"><TextBox Text="{Binding Services.ErrorDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,7,0,0"/></Expander></StackPanel></Border>
    </Grid>
  </Grid>
</Window>
