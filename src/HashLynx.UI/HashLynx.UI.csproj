<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('../../assets/branding/logo.ico')">../../assets/branding/logo.ico</ApplicationIcon>
    <AssemblyName>HashLynx</AssemblyName>
    <RootNamespace>HashLynx.UI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HashLynx.Core/HashLynx.Core.csproj" />
    <ProjectReference Include="../HashLynx.Hashcat/HashLynx.Hashcat.csproj" />
    <ProjectReference Include="../HashLynx.Extractors/HashLynx.Extractors.csproj" />
    <ProjectReference Include="../HashLynx.Persistence/HashLynx.Persistence.csproj" />
    <ProjectReference Include="../HashLynx.Drives/HashLynx.Drives.csproj" />
    <ProjectReference Include="../HashLynx.DriveReader/HashLynx.DriveReader.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../HashLynx.Updates/HashLynx.Updates.csproj" />
    <ProjectReference Include="../HashLynx.Updater/HashLynx.Updater.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="../../CHANGELOG.md" LogicalName="HashLynx.Changelog.md" />
    <None Include="../../CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="../../assets/branding/logo.png" Link="Assets/logo.png" />
    <Resource Include="../../assets/branding/logo_withText.png" Link="Assets/logo_withText.png" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyDriveReaderBuild" AfterTargets="Build">
    <ItemGroup><DriveReaderFiles Include="../HashLynx.DriveReader/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/*" Exclude="../HashLynx.DriveReader/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/*.pdb" /></ItemGroup>
    <Copy SourceFiles="@(DriveReaderFiles)" DestinationFolder="$(TargetDir)DriveReader" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyDriveReaderPublish" AfterTargets="Publish">
    <ItemGroup><PublishedDriveReaderFiles Include="$(TargetDir)DriveReader/*" /></ItemGroup>
    <Copy SourceFiles="@(PublishedDriveReaderFiles)" DestinationFolder="$(PublishDir)DriveReader" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyUpdaterBuild" AfterTargets="Build">
    <ItemGroup><UpdaterFiles Include="../HashLynx.Updater/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/*" Exclude="../HashLynx.Updater/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/*.pdb" /></ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(TargetDir)Updater" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyUpdaterPublish" AfterTargets="Publish">
    <ItemGroup><PublishedUpdaterFiles Include="$(TargetDir)Updater/*" /></ItemGroup>
    <Copy SourceFiles="@(PublishedUpdaterFiles)" DestinationFolder="$(PublishDir)Updater" SkipUnchangedFiles="true" />
  </Target>
</Project>
