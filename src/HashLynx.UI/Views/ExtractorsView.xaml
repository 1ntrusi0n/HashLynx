<UserControl x:Class="HashLynx.UI.Views.ExtractorsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,25,30,20"><DockPanel><Button Content="Refresh availability" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Top"/><TextBlock Text="Extractors" Style="{StaticResource PageTitle}"/></DockPanel><TextBlock Text="Read encrypted-file metadata locally into the Target Inspector." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
    <Border Style="{StaticResource Card}"><TextBlock Text="ZIP, RAR and 7-Zip extraction are built in: leave their tool paths blank. Other formats use separately configured external tools with their own licenses. Script adapters need a compatible Python or Perl runtime. BitLocker uses the detected Hashcat-supplied script for supported partition images." Style="{StaticResource Muted}" TextWrapping="Wrap"/></Border>
    <ItemsControl ItemsSource="{Binding Extractors}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><DockPanel><Border DockPanel.Dock="Right" Background="{DynamicResource InputBrush}" CornerRadius="5" Padding="10,6" VerticalAlignment="Top"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/></Border><TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"/></DockPanel><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Diagnostic}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,10,0,0"/><Expander Header="Configure tool &amp; runtime"><StackPanel Margin="0,8,0,0"><TextBlock Text="Tool executable or script" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Command="{Binding BrowseToolCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding ToolPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Text="Interpreter executable · leave blank to detect" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Command="{Binding BrowseInterpreterCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding InterpreterPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Text="{Binding Implementation}" Style="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock Text="{Binding Version}" Style="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock Text="{Binding Extensions}" Style="{StaticResource Muted}" Margin="0,4,0,12"/><WrapPanel><Button Content="Save configuration" Command="{Binding SaveCommand}"/><Button Content="Test / validate" Command="{Binding TestCommand}"/></WrapPanel></StackPanel></Expander></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
</UserControl>
