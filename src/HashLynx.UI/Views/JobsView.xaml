<UserControl x:Class="HashLynx.UI.Views.JobsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="JobsScrollViewer" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,25,30,20"><TextBlock Text="Jobs" Style="{StaticResource PageTitle}"/><TextBlock Text="Local sessions, live backend status, and recoverable work." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="DeleteSessionButton" Content="Delete session" Command="{Binding DeleteCommand}" ToolTip="Remove this inactive session from history. Recovery files stay on disk."/><Button Content="Undo delete" Command="{Binding UndoDeleteCommand}"/></WrapPanel><TextBlock Text="Session history" Style="{StaticResource SectionTitle}"/></DockPanel><DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" Height="210"><DataGrid.Columns><DataGridTextColumn Header="Session" Binding="{Binding Name, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State, Mode=OneWay}" Width="185"/><DataGridTextColumn Header="Progress" Binding="{Binding Progress, Mode=OneWay, StringFormat={}{0:F1}%}" Width="90"/><DataGridTextColumn Header="Created" Binding="{Binding Created, Mode=OneWay}" Width="155"/></DataGrid.Columns></DataGrid><TextBlock Text="Delete removes an inactive session from history and keeps its recovery files. Undo is available until you close HashLynx." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="{Binding Selected.State}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding Selected.Name, TargetNullValue=Select a session}" Style="{StaticResource SectionTitle}"/></DockPanel>
      <TextBlock x:Name="JobOutcomeTitle" Text="{Binding Selected.OutcomeTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock x:Name="JobOutcomeDetail" Text="{Binding Selected.OutcomeDetail}" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <Border x:Name="JobWordlistPanel" Background="{DynamicResource InputBrush}" Padding="14" CornerRadius="6" Margin="0,0,0,14" Visibility="{Binding Selected.HasWordlists, Converter={StaticResource BoolVisibility}}"><StackPanel>
        <TextBlock Text="WORDLIST SIZE" Style="{StaticResource Muted}"/>
        <TextBlock x:Name="JobWordlistLines" Text="{Binding Selected.WordlistLines, Mode=OneWay}" FontSize="22" Margin="0,5,0,5" TextWrapping="Wrap"/>
        <TextBlock x:Name="JobWordlistDetail" Text="{Binding Selected.WordlistDetail, Mode=OneWay}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Selected.WordlistCountNotice, Mode=OneWay}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
      </StackPanel></Border>
      <WrapPanel Margin="0,0,0,12"><Button x:Name="JobNextActionButton" Content="{Binding Selected.NextActionLabel}" Command="{Binding NextActionCommand}" Visibility="{Binding Selected.HasNextAction, Converter={StaticResource BoolVisibility}}"/><Button x:Name="ViewRecoveredPasswordsButton" Content="View session results" Command="{Binding ViewResultsCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel>
      <TextBlock Text="{Binding Selected.RecoveryMessage}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
      <TextBlock Text="{Binding Selected.ComputeDevice, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
      <TextBlock x:Name="JobProgressText" Text="{Binding Selected.ProgressText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" ToolTip="Progress counts password-check work, including rule variations and rejected guesses. It is not an exact count of physical file lines read." AutomationProperties.HelpText="Progress counts password-check work, including rule variations and rejected guesses. It is not an exact count of physical file lines read."/>
      <TextBlock Text="{Binding Selected.ProgressNote, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,10"/><ProgressBar x:Name="JobProgressBar" Value="{Binding Selected.Progress, Mode=OneWay}" Maximum="100" Margin="0,0,0,20"/>
      <UniformGrid Columns="2" Margin="0,0,0,10">
        <StackPanel Margin="0,0,20,10"><TextBlock Text="{Binding Selected.EstimateScope, Mode=OneWay}" Style="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="JobRemaining" Text="{Binding Selected.Remaining, Mode=OneWay}" FontSize="20" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Margin="0,0,0,10"><TextBlock Text="ESTIMATED ACTIVE DURATION" Style="{StaticResource Muted}" TextWrapping="Wrap" ToolTip="Observed active time plus estimated remaining time for this pass. Setup, pauses and work before a restored checkpoint are excluded." AutomationProperties.HelpText="Observed active time plus estimated remaining time for this pass. Setup, pauses and work before a restored checkpoint are excluded."/><TextBlock x:Name="JobEstimatedDuration" Text="{Binding Selected.EstimatedDuration, Mode=OneWay}" FontSize="20" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
      </UniformGrid>
      <TextBlock x:Name="JobEstimateNote" Text="{Binding Selected.EstimateNote, Mode=OneWay}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
      <UniformGrid Columns="3"><StackPanel Margin="0,0,15,15"><TextBlock Text="SPEED" Style="{StaticResource Muted}" ToolTip="Candidate checks per second. Different hash formats can have very different speeds." AutomationProperties.HelpText="Candidate checks per second. Different hash formats can have very different speeds."/><TextBlock Text="{Binding Selected.Speed}" FontSize="22" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,15,15"><TextBlock Text="RECOVERED" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Selected.Recovered}" FontSize="22" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,15,15"><TextBlock Text="ELAPSED" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Selected.Elapsed}" FontSize="22" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock Text="ESTIMATED COMPLETION" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Selected.Eta}" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock Text="REJECTED" Style="{StaticResource Muted}" ToolTip="Candidates the backend could not test, often because their length is unsupported. This does not mean a password was wrong." AutomationProperties.HelpText="Candidates the backend could not test, often because their length is unsupported. This does not mean a password was wrong."/><TextBlock Text="{Binding Selected.Rejected}" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock Text="RESTORE POINT" Style="{StaticResource Muted}" ToolTip="The saved position used to resume this exact attack. It is not the number of recovered passwords." AutomationProperties.HelpText="The saved position used to resume this exact attack. It is not the number of recovered passwords."/><TextBlock Text="{Binding Selected.RestorePoint}" Margin="0,6,0,0"/></StackPanel></UniformGrid>
      <WrapPanel Margin="0,24,0,10"><Button Content="Pause" ToolTip="Temporarily pauses this running process. Resume continues it without closing the application." AutomationProperties.HelpText="Temporarily pauses this running process. Resume continues it without closing the application." Command="{Binding PauseCommand}"/><Button Content="Resume" ToolTip="Continues a process paused in this session." AutomationProperties.HelpText="Continues a process paused in this session." Command="{Binding ResumeCommand}"/><Button Content="Checkpoint" ToolTip="Ask Hashcat to stop at its next checkpoint so the saved session can be restored later." AutomationProperties.HelpText="Ask Hashcat to stop at its next checkpoint so the saved session can be restored later." Command="{Binding CheckpointCommand}"/><Button Content="Status" Command="{Binding RefreshCommand}"/><Button Content="Stop" ToolTip="Stop the process now. Work after the latest saved checkpoint may need to be repeated." AutomationProperties.HelpText="Stop the process now. Work after the latest saved checkpoint may need to be repeated." Command="{Binding StopCommand}"/><Button Content="Restore session" ToolTip="Resume only with the original backend, unchanged inputs and a compatible saved checkpoint." AutomationProperties.HelpText="Resume only with the original backend, unchanged inputs and a compatible saved checkpoint." Command="{Binding RestoreCommand}"/></WrapPanel>
      <TextBlock Text="Interactive controls are disabled unless the installed backend’s redirected-input support has been verified. Stop terminates the process; Restore uses a saved checkpoint." Style="{StaticResource Muted}"/>
      <TextBlock x:Name="RestoreGuidance" Text="{Binding Selected.RestoreGuidance}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
      <Expander x:Name="JobTechnicalDetails" Header="Technical details" Margin="0,16,0,10"><TextBlock Text="{Binding Selected.Diagnostic}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource WarningBrush}"/></Expander>
      <Expander Header="Device activity"><DataGrid ItemsSource="{Binding Selected.Devices}" MaxHeight="180" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" Width="45"/><DataGridTextColumn Header="Device" Binding="{Binding Name, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Speed (H/s)" Binding="{Binding SpeedHashesPerSecond, Mode=OneWay, StringFormat=N0}" Width="130"/><DataGridTextColumn Header="Temp (°C)" Binding="{Binding Temperature, Mode=OneWay}" Width="90"/><DataGridTextColumn Header="Use (%)" Binding="{Binding Utilization, Mode=OneWay}" Width="75"/></DataGrid.Columns></DataGrid></Expander>
      <Expander Header="Session paths"><StackPanel Margin="0,10,0,0"><TextBlock Text="Output" Style="{StaticResource Label}"/><TextBox Text="{Binding Selected.Output, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="Session" Style="{StaticResource Label}"/><TextBox Text="{Binding Selected.Session, Mode=OneWay}" IsReadOnly="True"/></StackPanel></Expander>
    </StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
