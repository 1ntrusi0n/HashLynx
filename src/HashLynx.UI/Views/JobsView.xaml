<UserControl x:Class="HashLynx.UI.Views.JobsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,25,30,20"><TextBlock Text="Jobs" Style="{StaticResource PageTitle}"/><TextBlock Text="Local sessions, live backend status, and recoverable work." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="DeleteSessionButton" Content="Delete session" Command="{Binding DeleteCommand}" ToolTip="Remove this inactive session from history. Recovery files stay on disk."/><Button Content="Undo delete" Command="{Binding UndoDeleteCommand}"/></WrapPanel><TextBlock Text="Session history" Style="{StaticResource SectionTitle}"/></DockPanel><DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" Height="210"><DataGrid.Columns><DataGridTextColumn Header="Session" Binding="{Binding Name, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State, Mode=OneWay}" Width="120"/><DataGridTextColumn Header="Progress" Binding="{Binding Progress, Mode=OneWay, StringFormat={}{0:F1}%}" Width="90"/><DataGridTextColumn Header="Created" Binding="{Binding Created, Mode=OneWay}" Width="155"/></DataGrid.Columns></DataGrid><TextBlock Text="Delete removes an inactive session from history and keeps its recovery files. Undo is available until you close HashLynx." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="{Binding Selected.State}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding Selected.Name, TargetNullValue=Select a session}" Style="{StaticResource SectionTitle}"/></DockPanel><TextBlock Text="{Binding Selected.RecoveryMessage}" TextWrapping="Wrap" Margin="0,0,0,10"/><Button x:Name="ViewRecoveredPasswordsButton" Content="View recovered passwords" Command="{Binding ViewResultsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,20"/><ProgressBar x:Name="JobProgressBar" Value="{Binding Selected.Progress, Mode=OneWay}" Maximum="100" Margin="0,0,0,20"/>
      <UniformGrid Columns="3"><StackPanel Margin="0,0,15,15"><TextBlock Text="SPEED" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Selected.Speed}" FontSize="22" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,15,15"><TextBlock Text="RECOVERED" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Selected.Recovered}" FontSize="22" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,15,15"><TextBlock Text="ELAPSED" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Selected.Elapsed}" FontSize="22" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock Text="ESTIMATED COMPLETION" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Selected.Eta}" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock Text="REJECTED" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Selected.Rejected}" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock Text="RESTORE POINT" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Selected.RestorePoint}" Margin="0,6,0,0"/></StackPanel></UniformGrid>
      <WrapPanel Margin="0,24,0,10"><Button Content="Pause" Command="{Binding PauseCommand}"/><Button Content="Resume" Command="{Binding ResumeCommand}"/><Button Content="Checkpoint" Command="{Binding CheckpointCommand}"/><Button Content="Status" Command="{Binding RefreshCommand}"/><Button Content="Stop" Command="{Binding StopCommand}"/><Button Content="Restore session" Command="{Binding RestoreCommand}"/></WrapPanel>
      <TextBlock Text="Interactive controls are disabled unless the installed backend’s redirected-input support has been verified. Stop terminates the process; Restore uses a saved checkpoint." Style="{StaticResource Muted}"/>
      <TextBlock Text="{Binding Selected.Diagnostic}" Margin="0,16,0,10" Foreground="{DynamicResource WarningBrush}"/>
      <Expander Header="Device activity"><DataGrid ItemsSource="{Binding Selected.Devices}" MaxHeight="180" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" Width="45"/><DataGridTextColumn Header="Device" Binding="{Binding Name, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Speed (H/s)" Binding="{Binding SpeedHashesPerSecond, Mode=OneWay, StringFormat=N0}" Width="130"/><DataGridTextColumn Header="Temp (°C)" Binding="{Binding Temperature, Mode=OneWay}" Width="90"/><DataGridTextColumn Header="Use (%)" Binding="{Binding Utilization, Mode=OneWay}" Width="75"/></DataGrid.Columns></DataGrid></Expander>
      <Expander Header="Session paths"><StackPanel Margin="0,10,0,0"><TextBlock Text="Output" Style="{StaticResource Label}"/><TextBox Text="{Binding Selected.Output, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="Session" Style="{StaticResource Label}"/><TextBox Text="{Binding Selected.Session, Mode=OneWay}" IsReadOnly="True"/></StackPanel></Expander>
    </StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
