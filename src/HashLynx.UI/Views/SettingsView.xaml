<UserControl x:Class="HashLynx.UI.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,25,30,20"><TextBlock Text="Settings &amp; About" Style="{StaticResource PageTitle}"/><TextBlock Text="Your backend, preferences, and local workspace." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Hashcat installation" Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose the folder containing the official Hashcat release and hashcat.exe. The release is maintained separately from HashLynx." Style="{StaticResource Muted}"/><TextBlock Text="Installation directory" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" Command="{Binding BrowseBackendCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding HashcatDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><WrapPanel Margin="0,14,0,12"><Button Content="Detect Hashcat" Command="{Binding DetectCommand}"/><Button Content="Validate Hashcat" Command="{Binding ValidateCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel><TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Preferences" Style="{StaticResource SectionTitle}"/><TextBlock Text="Default output directory" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" Command="{Binding BrowseOutputCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><UniformGrid Columns="3" Margin="0,4,0,0"><StackPanel Margin="0,0,15,0"><TextBlock Text="Theme" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"/></StackPanel><StackPanel Margin="0,0,15,0"><TextBlock Text="Default workload" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Workloads}" SelectedItem="{Binding Workload}" IsEnabled="{Binding WorkloadEffective}" ToolTip="{Binding WorkloadHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding WorkloadHelp}"/></StackPanel><StackPanel><TextBlock Text="Status interval · seconds" Style="{StaticResource Label}"/><TextBox Text="{Binding Interval}"/></StackPanel></UniformGrid><TextBlock Text="{Binding WorkloadHelp}" Style="{StaticResource Muted}" Margin="0,8,0,4"/><CheckBox Content="Start in Expert mode" IsChecked="{Binding Expert}" ToolTip="Applies when HashLynx starts. The Expert switch on Attack changes only the current session." AutomationProperties.HelpText="Unchecked starts in Beginner mode. This preference takes effect on the next launch."/><CheckBox Content="Show Windows completion notifications (passwords stay hidden)" IsChecked="{Binding CompletionNotifications}"/><TextBlock Text="PDF, ZIP, RAR, 7-Zip, BitLocker, Office and KeePass extraction is built in. Select an encrypted file in Target Inspector." Style="{StaticResource Muted}" Margin="0,5,0,16"/><Button Content="Save preferences" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Application updates" Style="{StaticResource SectionTitle}"/>
      <CheckBox x:Name="AutoUpdatesCheckBox" Content="Check for Updates Automatically" IsChecked="{Binding CheckForUpdatesAutomatically}" ToolTip="After saving, check GitHub at startup at most once a day. Downloads and installation always require your choice." AutomationProperties.HelpText="Optional GitHub version checks. No recovery data is sent; updates are never installed automatically."/>
      <TextBlock Text="Save preferences to remember this choice. Checks contact GitHub; targets, passwords, wordlists, and job data are never sent." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
      <StackPanel DataContext="{Binding Updates}">
        <WrapPanel><Button x:Name="CheckUpdatesButton" Content="Check for Updates" Command="{Binding CheckCommand}"/><Button Content="Copy release page link" Command="{Binding CopyReleaseLinkCommand}"/></WrapPanel>
        <TextBlock x:Name="UpdateStatusText" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,8" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Visibility="{Binding HasRelease, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{Binding ReleaseTitle}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding DownloadSize}" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
          <Expander Header="Release notes"><TextBox Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10"/></Expander>
          <WrapPanel Margin="0,8,0,0"><Button Content="Download update" Command="{Binding DownloadCommand}"/><Button Content="Restart and update" Command="{Binding RestartCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsReadyToInstall, Converter={StaticResource BoolVisibility}}"/></WrapPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,10,0,10"/><Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left"/></StackPanel>
        <TextBlock Text="Installation waits until recovery and other work are idle. Hashcat, drivers, and runtimes are managed separately. Development builds and protected folders require a manual update." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
      </StackPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Local data &amp; diagnostics" Style="{StaticResource SectionTitle}"/><TextBlock Text="Data directory" Style="{StaticResource Label}"/><TextBox Text="{Binding DataLocation, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="Sanitized logs" Style="{StaticResource Label}"/><TextBox Text="{Binding LogLocation, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="Settings, profiles, job history, targets, and recovered results stay under your user profile. Application logs exclude recovered plaintext, full targets, and command arguments." Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="AboutVersionText" Text="{Binding Version}" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="CreatorCreditText" Text="Created by err0r" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/><TextBlock Text="An independent, open-source Windows frontend for Hashcat." Margin="0,0,0,8"/><TextBlock Text="Built for legitimate password recovery, authorized security auditing, research, labs, and CTFs. Hashcat is a separate third-party project. HashLynx is not affiliated with or endorsed by the Hashcat project." Style="{StaticResource Muted}"/><TextBlock Text="HashLynx is MIT licensed. External extractors retain their own licenses. No telemetry. Optional GitHub checks retrieve release information; application downloads and installation require your explicit choice." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="What's new" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Release history included with this application. Available offline." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
      <Expander x:Name="ChangelogExpander" Header="Changelog"><TextBox x:Name="ChangelogText" Text="{Binding Changelog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" AutomationProperties.Name="HashLynx changelog"/></Expander>
    </StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
