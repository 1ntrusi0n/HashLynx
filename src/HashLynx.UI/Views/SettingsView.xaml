<UserControl x:Class="HashLynx.UI.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,25,30,20"><TextBlock Text="Settings &amp; About" Style="{StaticResource PageTitle}"/><TextBlock Text="Your backend, preferences, and local workspace." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Hashcat installation" Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose the folder containing the official Hashcat release and hashcat.exe. The release is maintained separately from HashLynx." Style="{StaticResource Muted}"/><TextBlock Text="Installation directory" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" Command="{Binding BrowseBackendCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding HashcatDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><WrapPanel Margin="0,14,0,12"><Button Content="Detect Hashcat" Command="{Binding DetectCommand}"/><Button Content="Validate Hashcat" Command="{Binding ValidateCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel><TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Preferences" Style="{StaticResource SectionTitle}"/><TextBlock Text="Default output directory" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" Command="{Binding BrowseOutputCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><UniformGrid Columns="3" Margin="0,4,0,0"><StackPanel Margin="0,0,15,0"><TextBlock Text="Theme" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"/></StackPanel><StackPanel Margin="0,0,15,0"><TextBlock Text="Default workload" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Workloads}" SelectedItem="{Binding Workload}"/></StackPanel><StackPanel><TextBlock Text="Status interval · seconds" Style="{StaticResource Label}"/><TextBox Text="{Binding Interval}"/></StackPanel></UniformGrid><CheckBox Content="Open attacks in Expert mode by default" IsChecked="{Binding Expert}"/><TextBlock Text="PDF, ZIP, RAR, 7-Zip and BitLocker extraction is built in. Select an encrypted file in Target Inspector." Style="{StaticResource Muted}" Margin="0,5,0,16"/><Button Content="Save preferences" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Local data &amp; diagnostics" Style="{StaticResource SectionTitle}"/><TextBlock Text="Data directory" Style="{StaticResource Label}"/><TextBox Text="{Binding DataLocation, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="Sanitized logs" Style="{StaticResource Label}"/><TextBox Text="{Binding LogLocation, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="Settings, profiles, job history, targets, and recovered results stay under your user profile. Application logs exclude recovered plaintext, full targets, and command arguments." Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Version}" Style="{StaticResource SectionTitle}"/><TextBlock Text="An independent, open-source Windows frontend for Hashcat." Margin="0,0,0,8"/><TextBlock Text="Built for legitimate password recovery, authorized security auditing, research, labs, and CTFs. Hashcat is a separate third-party project. HashLynx is not affiliated with or endorsed by the Hashcat project." Style="{StaticResource Muted}"/><TextBlock Text="HashLynx is MIT licensed. External extractors retain their own licenses. No telemetry or automatic executable downloads." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
