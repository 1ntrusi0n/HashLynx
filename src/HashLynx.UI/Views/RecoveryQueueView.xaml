<UserControl x:Class="HashLynx.UI.Views.RecoveryQueueView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,25,30,20">
    <TextBlock TextWrapping="Wrap" Text="Attack queue" Style="{StaticResource PageTitle}"/>
    <TextBlock TextWrapping="Wrap" Text="Run one attempt at a time. Each sequence uses one target and stops when all its hashes are recovered." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,14"/>
      <WrapPanel><Button Content="Start queue" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Pause after current step" Command="{Binding PauseCommand}"/><Button Content="View session" Command="{Binding ViewSessionCommand}"/></WrapPanel>
      <DataGrid x:Name="RecoveryQueueGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Height="300" Margin="0,15,0,10"><DataGrid.Columns>
        <DataGridTextColumn Header="Sequence" Binding="{Binding Sequence, Mode=OneWay}" Width="180"/>
        <DataGridTextColumn Header="#" Binding="{Binding Number, Mode=OneWay}" Width="35"/>
        <DataGridTextColumn Header="Attempt" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
        <DataGridTextColumn Header="State" Binding="{Binding State, Mode=OneWay}" Width="100"/>
      </DataGrid.Columns></DataGrid>
      <TextBlock Text="{Binding Selected.Message}" TextWrapping="Wrap" Margin="0,0,0,14"/>
      <WrapPanel><Button Content="Move step up" Command="{Binding MoveUpCommand}"/><Button Content="Move step down" Command="{Binding MoveDownCommand}"/><Button Content="Retry step" Command="{Binding RetryCommand}"/><Button Content="Skip step" Command="{Binding SkipCommand}"/><Button Content="Remove sequence" Command="{Binding RemoveCommand}"/></WrapPanel>
      <TextBlock TextWrapping="Wrap" Text="Failures pause the queue. After restarting HashLynx, review the saved queue and start it yourself. Retry starts a fresh attempt; use Jobs to restore a saved checkpoint instead." Style="{StaticResource Muted}" Margin="0,14,0,0"/>
      <TextBlock TextWrapping="Wrap" Text="Each step keeps its own results. A sequence shares a private recovery cache to skip hashes recovered by earlier steps. Wordlist and custom-rule files must remain available. Removing a sequence keeps its sessions and files." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
    </StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
