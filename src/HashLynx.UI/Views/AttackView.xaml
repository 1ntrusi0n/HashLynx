<UserControl x:Class="HashLynx.UI.Views.AttackView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:HashLynx.UI.Views" xmlns:infra="clr-namespace:HashLynx.UI.Infrastructure">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,25,30,20">
    <DockPanel><CheckBox DockPanel.Dock="Right" Content="Expert mode" IsChecked="{Binding Expert}"/><TextBlock Text="Build an attack" Style="{StaticResource PageTitle}"/></DockPanel><TextBlock Text="Inspect your target. Choose an approach. Review and run locally." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
    <views:InspectorView DataContext="{Binding Inspector}"/>
    <Border Style="{StaticResource Card}"><StackPanel>
      <DockPanel><TextBlock Text="02" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="Attack configuration" Style="{StaticResource SectionTitle}"/></DockPanel>
      <TextBlock Text="{Binding AttackErrors}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,0,6"/><TabControl SelectedIndex="{Binding Family}"><TabItem Header="Dictionary"/><TabItem Header="Mask"/><TabItem Header="Hybrid"/><TabItem Header="Combinator"/></TabControl>
      <StackPanel Visibility="{Binding IsHybrid, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,10"><TextBlock Text="Hybrid direction" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding HybridDirections}" SelectedIndex="{Binding HybridDirection}"/></StackPanel>
      <StackPanel Visibility="{Binding UsesWordlists, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="Wordlists · drop files to add them" Style="{StaticResource Label}"/>
        <ListBox ItemsSource="{Binding Wordlists}" SelectedItem="{Binding SelectedWordlist}" Height="105" infra:DropFiles.Command="{Binding DropWordlistsCommand}"/>
        <WrapPanel Margin="0,10,0,0"><Button Content="Add wordlists…" Command="{Binding AddWordlistsCommand}"/><Button Content="Remove" Command="{Binding RemoveWordlistCommand}"/><Button Content="↑" ToolTip="Move selected wordlist up" Command="{Binding MoveWordlistUpCommand}"/><Button Content="↓" ToolTip="Move selected wordlist down" Command="{Binding MoveWordlistDownCommand}"/></WrapPanel>
        <StackPanel Visibility="{Binding IsDictionary, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Optional rule files" Style="{StaticResource Label}"/><ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" Height="74" infra:DropFiles.Command="{Binding DropRulesCommand}"/>
        <WrapPanel Margin="0,10,0,4"><Button Content="Add rules…" Command="{Binding AddRulesCommand}"/><Button Content="Browse bundled rules…" Command="{Binding BundledRulesCommand}"/><Button Content="Remove rule" Command="{Binding RemoveRuleCommand}"/></WrapPanel>
        <CheckBox Content="Loopback (Dictionary only)" IsChecked="{Binding Loopback}" ToolTip="Use recovered plaintext from the potfile as additional wordlist candidates when supported."/></StackPanel>
      </StackPanel>
      <StackPanel Visibility="{Binding UsesMask, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="Mask" Style="{StaticResource Label}"/><TextBox Text="{Binding Mask, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
        <TextBlock Text="?l lowercase · ?u uppercase · ?d digits · ?h / ?H hex · ?s symbols · ?a printable · ?b bytes · ?? literal ?" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
        <TextBlock Text="Mask file (when set, takes precedence over the mask field)" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Command="{Binding BrowseMaskCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding MaskFile, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
        <WrapPanel VerticalAlignment="Center"><CheckBox Content="Increment length" IsChecked="{Binding Increment}"/><TextBlock Text="Min" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding IncrementMinimum}" Width="50" Margin="0,8,14,0"/><TextBlock Text="Max" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding IncrementMaximum}" Width="50" Margin="0,8,0,0"/></WrapPanel>
        <Expander Header="Custom charsets · reference as ?1, ?2, ?3, ?4"><UniformGrid Columns="2" Margin="0,6,0,0"><StackPanel Margin="0,0,12,0"><TextBlock Text="?1" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset1, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="?2" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="?3" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset3, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="?4" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset4, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></UniformGrid></Expander>
      </StackPanel>
      <StackPanel Visibility="{Binding IsCombinator, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="Each left word combines with each right word, in that order." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
        <TextBlock Text="Left wordlist" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Command="{Binding BrowseLeftCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding LeftWordlist, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
        <TextBlock Text="+" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,5"/>
        <TextBlock Text="Right wordlist" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Command="{Binding BrowseRightCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding RightWordlist, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
      </StackPanel>
      <Expander Visibility="{Binding UsesSingleRules, Converter={StaticResource BoolVisibility}}" Header="Single left / right rules (supported combinations only)"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="15"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Left rule expression" Style="{StaticResource Label}"/><TextBox Text="{Binding LeftRule, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hashcat --rule-left expression, for example l to lowercase."/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Right rule expression" Style="{StaticResource Label}"/><TextBox Text="{Binding RightRule, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid></Expander>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Run options" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding CommonErrors}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,0,6"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Session name" Style="{StaticResource Label}"/><TextBox Text="{Binding Session, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Workload · 1 light → 4 heavy" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Workloads}" SelectedItem="{Binding Workload}"/></StackPanel></Grid>
      <CheckBox Content="Optimized kernels · may limit password length" IsChecked="{Binding OptimizedKernel}"/>
      <Expander Header="Advanced"><StackPanel Margin="0,6,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Device IDs · comma separated; blank uses defaults" Style="{StaticResource Label}"/><TextBox Text="{Binding Devices, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Temperature abort threshold · °C; optional" Style="{StaticResource Label}"/><TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
        <TextBlock Text="Results output · blank creates a separate file per job" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" Command="{Binding BrowseOutputCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
        <TextBlock Text="Potfile · blank uses HashLynx’s local potfile" Style="{StaticResource Label}"/><TextBox Text="{Binding PotfilePath, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Disable potfile for this job" IsChecked="{Binding DisablePotfile}"/>
        <StackPanel Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Additional arguments · one argument per line; do not add shell quotes" Style="{StaticResource Label}"/><TextBox Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}" Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/><TextBlock Text="Internally managed options cannot be overridden. Preflight reports conflicts." Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
      </StackPanel></Expander>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="03" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="Command preview &amp; preflight" Style="{StaticResource SectionTitle}"/></DockPanel><TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="85" MaxHeight="220" VerticalScrollBarVisibility="Auto"/><TextBlock Text="{Binding Preflight}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,12,0,16"/><WrapPanel><Button Content="Run preflight" Command="{Binding PreflightCommand}"/><Button Content="Copy command" Command="{Binding CopyCommand}"/><Button Content="Start recovery →" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Attack profiles" Style="{StaticResource SectionTitle}"/><TextBlock Text="Save configuration for another run. Targets and recovered results are excluded." Style="{StaticResource Muted}"/><DockPanel Margin="0,12,0,10"><Button Content="Load" DockPanel.Dock="Right" Command="{Binding LoadProfileCommand}" Margin="8,0"/><Button Content="Delete" DockPanel.Dock="Right" Command="{Binding DeleteProfileCommand}" Margin="0"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"/></DockPanel><DockPanel><Button Content="Save profile" DockPanel.Dock="Right" Command="{Binding SaveProfileCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name your profile"/></DockPanel></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
