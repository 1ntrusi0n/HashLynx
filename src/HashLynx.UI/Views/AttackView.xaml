<UserControl x:Class="HashLynx.UI.Views.AttackView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:HashLynx.UI.Views" xmlns:infra="clr-namespace:HashLynx.UI.Infrastructure" xmlns:vm="clr-namespace:HashLynx.UI.ViewModels">
  <UserControl.Resources>
    <infra:FileNameConverter x:Key="FileName"/>
    <Style x:Key="ReadinessText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:ReadinessState.Ready}"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:ReadinessState.NeedsAttention}"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <ScrollViewer x:Name="AttackScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="30,25,30,20">
    <DockPanel><CheckBox x:Name="SessionExpertCheckBox" DockPanel.Dock="Right" Content="Expert mode (this session)" IsChecked="{Binding Expert}" ToolTip="Show advanced methods and controls for this session. Settings controls whether HashLynx starts in Expert mode." AutomationProperties.HelpText="Show advanced methods for this session. The startup preference is in Settings."/><TextBlock TextWrapping="Wrap" Text="Recover a password" Style="{StaticResource PageTitle}"/></DockPanel><TextBlock TextWrapping="Wrap" Text="Choose your target and how to try passwords. Each method explains what it needs before you start." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
    <Border x:Name="ReadinessCard" Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Ready to recover" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="{Binding ReadinessSummary}" Tag="{Binding OverallReadinessState}" Style="{StaticResource ReadinessText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <DockPanel Margin="0,4"><Button Content="{Binding TargetActionLabel}" Command="{Binding ReviewTargetCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/><StackPanel><TextBlock Text="1 · Target" FontWeight="SemiBold"/><TextBlock x:Name="TargetReadinessText" Text="{Binding TargetReadiness}" Tag="{Binding TargetReadinessState}" TextWrapping="Wrap" Style="{StaticResource ReadinessText}"/></StackPanel></DockPanel>
      <DockPanel Margin="0,8"><Button Content="Choose inputs" Command="{Binding ReviewInputsCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/><StackPanel><TextBlock Text="2 · Recovery method" FontWeight="SemiBold"/><TextBlock x:Name="InputsReadinessText" Text="{Binding InputsReadiness}" Tag="{Binding InputsReadinessState}" TextWrapping="Wrap" Style="{StaticResource ReadinessText}"/></StackPanel></DockPanel>
      <DockPanel Margin="0,4"><Button Content="{Binding DeviceActionLabel}" Command="{Binding ReviewDeviceCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/><StackPanel><TextBlock Text="3 · Device" FontWeight="SemiBold"/><TextBlock x:Name="DeviceReadinessText" Text="{Binding DeviceReadiness}" Tag="{Binding DeviceReadinessState}" TextWrapping="Wrap" Style="{StaticResource ReadinessText}"/></StackPanel></DockPanel>
      <Button Content="Refresh checks" Command="{Binding RefreshReadinessCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Recheck files after reconnecting a drive or changing them outside HashLynx."/>
    </StackPanel></Border>
    <views:InspectorView x:Name="TargetSection" DataContext="{Binding Inspector}"/>
    <Border Style="{StaticResource Card}" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}"><Expander x:Name="HintsExpander" Header="What do you remember? Build a recovery sequence"><views:PasswordHintsView DataContext="{Binding Hints}"/></Expander></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
      <DockPanel x:Name="InputsSection"><TextBlock TextWrapping="Wrap" Text="02" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" Text="Attack configuration" Style="{StaticResource SectionTitle}"/></DockPanel>
      <TextBlock TextWrapping="Wrap" Text="{Binding AttackErrors}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,0,6"/>
      <TabControl x:Name="RecoveryMethodTabs" SelectedIndex="{Binding Family}" AutomationProperties.Name="Recovery method">
        <TabItem Header="Wordlist" ToolTip="Try words from a text file. Optional rules add variations such as capitals and digits." AutomationProperties.HelpText="Try words from a text file and optional variations."/>
        <TabItem Header="Known pattern" ToolTip="Describe character types you remember, or choose common structures. More unknown positions can greatly increase the work." AutomationProperties.HelpText="Try passwords matching a known character pattern."/>
        <TabItem x:Name="HybridMethodTab" Header="Hybrid" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}" ToolTip="Add a character pattern before or after each word."/>
        <TabItem x:Name="CombinatorMethodTab" Header="Combinator" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}" ToolTip="Join every left word with every right word. List sizes multiply."/>
        <TabItem x:Name="PcfgMethodTab" Header="Likely passwords" Visibility="{Binding ShowPcfgMethod, Converter={StaticResource BoolVisibility}}" ToolTip="PCFG uses a statistical model included with Hashcat 8 to try likely passwords first. No wordlist is needed." AutomationProperties.HelpText="PCFG uses Hashcat 8’s included probability model. No wordlist is needed."/>
        <TabItem x:Name="WordlistPatternMethodTab" Header="Wordlist pattern" Visibility="{Binding ShowWordlistPatternMethod, Converter={StaticResource BoolVisibility}}" ToolTip="Hashcat 8 can place whole words inside a pattern using ?w and ?q."/>
      </TabControl>
      <TextBlock Text="{Binding MethodDescription}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,10,0,6"/>
      <TextBlock Text="{Binding MethodAvailability}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,0,6"/>
      <StackPanel x:Name="PcfgMethodPanel" Visibility="{Binding IsPcfg, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,12">
        <TextBlock Text="Uses the default model from your installed Hashcat release, entirely on this computer. Its ranking comes from training data, so it may miss unusual passwords. No files are downloaded." TextWrapping="Wrap" Style="{StaticResource Muted}"/>
        <Expander x:Name="PcfgExpertOptions" Header="PCFG hints and restrictions" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}">
          <StackPanel Margin="0,8,0,0">
            <CheckBox Content="Use remembered words with the included hint model" IsChecked="{Binding PcfgUseHints}" ToolTip="Hint mode uses the separate included hints model. Remembered words are saved privately in your local workspace." AutomationProperties.HelpText="Use the included hint model with words you remember. Hints stay local."/>
            <StackPanel Visibility="{Binding PcfgUseHints, Converter={StaticResource BoolVisibility}}">
              <TextBlock Text="Remembered words · one per line" Style="{StaticResource Label}"/>
              <TextBox x:Name="PcfgHintWords" Text="{Binding PcfgHintWords, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" MaxLength="32768" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="PCFG remembered words"/>
            </StackPanel>
            <TextBlock Text="Restrict the guesses (optional)" Style="{StaticResource Label}"/>
            <ComboBox ItemsSource="{Binding PcfgConstraints}" SelectedIndex="{Binding PcfgConstraint}" AutomationProperties.Name="PCFG restriction" ToolTip="Choose a length range or a character shape. These restrictions cannot be combined."/>
            <WrapPanel Visibility="{Binding PcfgUsesLength, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0"><TextBlock Text="Length from" VerticalAlignment="Center"/><TextBox Text="{Binding PcfgMinimumLength, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="8,0,16,0" AutomationProperties.Name="PCFG minimum length"/><TextBlock Text="to" VerticalAlignment="Center"/><TextBox Text="{Binding PcfgMaximumLength, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="8,0" AutomationProperties.Name="PCFG maximum length"/><TextBlock Text="Leave either end blank for no limit." Style="{StaticResource Muted}" VerticalAlignment="Center"/></WrapPanel>
            <StackPanel Visibility="{Binding PcfgUsesShape, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Character shape" Style="{StaticResource Label}"/><TextBox Text="{Binding PcfgShape, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="PCFG character shape" ToolTip="Use a supported PCFG shape, for example ?u?l?l?l?d?d. Preflight checks the installed backend’s restrictions."/><TextBlock Text="A shape restricts character types in each position; it does not add a second attack. Review preflight before starting." Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
      <StackPanel Visibility="{Binding IsHybrid, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,10"><TextBlock TextWrapping="Wrap" Text="Hybrid direction" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding HybridDirections}" SelectedIndex="{Binding HybridDirection}"/></StackPanel>
      <StackPanel Visibility="{Binding UsesWordlists, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="Saved wordlists" Style="{StaticResource Label}"/>
        <ComboBox x:Name="SavedWordlistPicker" ItemsSource="{Binding SavedWordlistEntries}" SelectedItem="{Binding SelectedSavedWordlistEntry}" AutomationProperties.Name="Saved wordlist" MaxDropDownHeight="280"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Path}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <TextBlock Text="{Binding SelectedSavedWordlist}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
        <TextBlock Text="Add or drop files once to remember them across restarts. Choose a saved list to use it; Expert mode adds it to the attack." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
        <TextBlock Text="{Binding WordlistLibraryNotice}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" FontSize="12"/>
        <TextBlock TextWrapping="Wrap" Text="Wordlists for this attack · drop files to add and remember them" Style="{StaticResource Label}"/><TextBlock TextWrapping="Wrap" Text="A wordlist is a text file with one starting word per line." Style="{StaticResource Muted}" Margin="0,0,0,7"/>
        <ListBox ItemsSource="{Binding Wordlists}" SelectedItem="{Binding SelectedWordlist}" MinHeight="45" MaxHeight="105" infra:DropFiles.Command="{Binding DropWordlistsCommand}"><ListBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Text="{Binding Converter={StaticResource FileName}}" ToolTip="{Binding}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
        <TextBlock TextWrapping="Wrap" Text="{Binding WordlistSummary}" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
        <WrapPanel Margin="0,10,0,0"><Button Content="{Binding WordlistButtonLabel}" Command="{Binding AddWordlistsCommand}" Margin="0,0,8,8"/><Button Content="Use starter list" Command="{Binding UseStarterCommand}" Margin="0,0,8,8"/><Button Content="Remove from attack" Command="{Binding RemoveWordlistCommand}" Margin="0,0,8,8"/><Button Content="Forget saved list" Command="{Binding ForgetWordlistCommand}" ToolTip="Remove the selected library entry. Keeps the file on disk and the current attack selection." Margin="0,0,8,8"/><Button Content="↑" ToolTip="Move selected wordlist up" Command="{Binding MoveWordlistUpCommand}" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8"/><Button Content="↓" ToolTip="Move selected wordlist down" Command="{Binding MoveWordlistDownCommand}" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8"/></WrapPanel>
      </StackPanel>
      <Expander x:Name="WordlistManagerExpander" Header="Manage wordlist library" Margin="0,12,0,8" Visibility="{Binding ShowWordlistLibrary, Converter={StaticResource BoolVisibility}}"><views:WordlistLibraryView DataContext="{Binding WordlistLibrary}"/></Expander>
      <StackPanel Visibility="{Binding RulesAvailable, Converter={StaticResource BoolVisibility}}">
        <CheckBox Content="Use custom rule files instead of a preset" IsChecked="{Binding UseCustomRules}" Visibility="{Binding ShowCustomRuleChoice, Converter={StaticResource BoolVisibility}}"/>
        <StackPanel x:Name="PresetRules" Visibility="{Binding ShowPresets, Converter={StaticResource BoolVisibility}}">
          <DockPanel Margin="0,10,0,6"><Button Content="?" Command="{Binding ToggleRulesHelpCommand}" ToolTip="What are rules, and which preset should I choose?" AutomationProperties.Name="Explain Dictionary rule presets" DockPanel.Dock="Right" Width="28" Height="28" Padding="0" Margin="8,0,0,0"/><TextBlock TextWrapping="Wrap" Text="Rules" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/></DockPanel>
          <ComboBox x:Name="RulesPresetPicker" ItemsSource="{Binding RulePresets}" SelectedItem="{Binding SelectedRulePreset}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Dictionary rules preset"/>
          <TextBlock TextWrapping="Wrap" Text="{Binding PresetSummary}" Margin="0,8,0,4"/><TextBlock TextWrapping="Wrap" Text="{Binding PresetEffort}" Style="{StaticResource Muted}"/>
          <Border x:Name="PresetHelp" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,12,0,0" Visibility="{Binding RulesHelpVisible, Converter={StaticResource BoolVisibility}}"><StackPanel>
            <TextBlock TextWrapping="Wrap" Text="How rules work" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBlock TextWrapping="Wrap" Text="Rules make variations of a word. For example, river can become River or river1. You supply the words; a preset chooses how many kinds of changes to try." FontSize="12"/>
            <TextBlock TextWrapping="Wrap" Text=":       → river&#10;c       → River&#10;$1      → river1&#10;c$1$!   → River1!" FontFamily="Consolas" FontSize="13" Margin="0,10,0,7"/>
            <TextBlock TextWrapping="Wrap" Text="The left side shows Hashcat instruction strings written in rule files. The right side shows their output for the starting word river. Rule files contain instructions, not lists of candidate passwords." Style="{StaticResource Muted}"/>
            <TextBlock TextWrapping="Wrap" Text="Quick — the shortest pass, for common small changes.&#10;Normal — a balanced first try with more variations.&#10;Heavy — broader coverage and a noticeably longer run.&#10;Super — the widest preset and potentially much more time." FontSize="12" Margin="0,12,0,12"/>
            <TextBlock TextWrapping="Wrap" Text="Approximate work = wordlist lines × rule count. Rules can produce duplicate candidates or reject a word, so the count is an upper estimate. Actual time depends on the hash type, hardware, and wordlist. More rules do not guarantee a recovered password." Style="{StaticResource Muted}"/>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="CustomRulesPanel" Visibility="{Binding ShowCustomRules, Converter={StaticResource BoolVisibility}}"><TextBlock TextWrapping="Wrap" Text="Custom rule files" Style="{StaticResource Label}"/><ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" Height="74" infra:DropFiles.Command="{Binding DropRulesCommand}"/><TextBlock TextWrapping="Wrap" Text="With no rule files, Hashcat tries the original words. By default, multiple rule files chain transformations and can multiply the work. Hashcat 8 also offers separate rule lists below." Style="{StaticResource Muted}" Margin="0,7,0,0"/><WrapPanel Margin="0,10,0,4"><Button Content="Add rules…" Command="{Binding AddRulesCommand}"/><Button Content="Browse Hashcat rules…" Command="{Binding BundledRulesCommand}"/><Button Content="Remove rule" Command="{Binding RemoveRuleCommand}"/></WrapPanel></StackPanel>
        <StackPanel Visibility="{Binding ShowCustomRules, Converter={StaticResource BoolVisibility}}"><CheckBox x:Name="ConcatenateRulesCheckBox" Content="Try rule lists separately" IsChecked="{Binding RulesConcatenated}" IsEnabled="{Binding CanConcatenateRules}" ToolTip="Hashcat 8 can append the rules from each file instead of chaining every combination. Two files with 100 and 200 rules become 300 rules, instead of 20,000 combinations." AutomationProperties.HelpText="Try each rule file separately. 100 plus 200 rules gives 300 instead of 20,000 chained combinations."/><TextBlock Text="Off: chain transformations from each file (100 × 200 = 20,000). On: try the rule lists separately (100 + 200 = 300). Requires Hashcat 8." Style="{StaticResource Muted}"/></StackPanel>
        <CheckBox Content="Loopback" IsChecked="{Binding Loopback}" Visibility="{Binding ShowLoopback, Converter={StaticResource BoolVisibility}}" ToolTip="Use recovered plaintext as additional candidates. Dictionary attacks need a preset or rule file for loopback."/>
      </StackPanel>
      <views:MaskSourcesView Visibility="{Binding UsesMask, Converter={StaticResource BoolVisibility}}"/>
      <StackPanel x:Name="WordlistPatternPanel" Visibility="{Binding IsWordlistPattern, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Pattern with word positions" Style="{StaticResource Label}"/><TextBox Text="{Binding WordlistPattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="Wordlist pattern" ToolTip="Use ?w for a whole word, for example ?w?d?d or ?w-?q. Select one or two ordered wordlists above."/><TextBlock Text="?w?d?d → river00 through river99. Use ?w for the first list and ?q for the second: ?w-?q joins one word from each around the hyphen. Use the arrows above to set list order." Style="{StaticResource Muted}" Margin="0,7,0,0"/><Expander Header="Custom character sets"><UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="?1" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset1, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="?2" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="?3" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset3, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="?4" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset4, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></UniformGrid></Expander></StackPanel>
      <StackPanel Visibility="{Binding IsCombinator, Converter={StaticResource BoolVisibility}}">
        <TextBlock TextWrapping="Wrap" Text="Each left word combines with each right word, in that order." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
        <TextBlock TextWrapping="Wrap" Text="Left wordlist" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Command="{Binding BrowseLeftCommand}" Margin="8,0,0,0"/><ComboBox x:Name="SavedLeftWordlistPicker" ItemsSource="{Binding SavedWordlists}" IsEditable="True" IsTextSearchEnabled="False" Text="{Binding LeftWordlist, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Left wordlist from saved library or path"/></DockPanel>
        <TextBlock TextWrapping="Wrap" Text="+" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,5"/>
        <TextBlock TextWrapping="Wrap" Text="Right wordlist" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Command="{Binding BrowseRightCommand}" Margin="8,0,0,0"/><ComboBox x:Name="SavedRightWordlistPicker" ItemsSource="{Binding SavedWordlists}" IsEditable="True" IsTextSearchEnabled="False" Text="{Binding RightWordlist, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Right wordlist from saved library or path"/></DockPanel>
      </StackPanel>
      <Expander Visibility="{Binding UsesSingleRules, Converter={StaticResource BoolVisibility}}" Header="Single left / right rules (supported combinations only)"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="15"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock TextWrapping="Wrap" Text="Left rule expression" Style="{StaticResource Label}"/><TextBox Text="{Binding LeftRule, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hashcat --rule-left expression, for example l to lowercase."/></StackPanel><StackPanel Grid.Column="2"><TextBlock TextWrapping="Wrap" Text="Right rule expression" Style="{StaticResource Label}"/><TextBox Text="{Binding RightRule, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid></Expander>
    </StackPanel></Border>
    <Border x:Name="RunOptionsPanel" Style="{StaticResource Card}" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock TextWrapping="Wrap" Text="Run options" Style="{StaticResource SectionTitle}"/><TextBlock TextWrapping="Wrap" Text="{Binding CommonErrors}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,0,6"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock TextWrapping="Wrap" Text="Session name" Style="{StaticResource Label}"/><TextBox Text="{Binding Session, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock TextWrapping="Wrap" Text="Workload · 1 light → 4 heavy" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Workloads}" SelectedItem="{Binding Workload}" IsEnabled="{Binding WorkloadSupported}" ToolTip="Higher workload may reduce desktop responsiveness. Hashcat 8 ignores this older setting and manages workload automatically." AutomationProperties.HelpText="Workload is a legacy backend preference. Hashcat 8 manages it automatically."/></StackPanel></Grid>
      <TextBlock Text="{Binding WorkloadGuidance}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
      <CheckBox Content="Optimized kernels · may limit password length" IsChecked="{Binding OptimizedKernel}" ToolTip="Some formats offer faster code with a smaller maximum password length. Leave this off if you do not know the possible length." AutomationProperties.HelpText="May run faster but reject longer passwords. Leave off when the length is unknown."/>
      <Expander Header="Advanced"><StackPanel Margin="0,6,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock TextWrapping="Wrap" Text="Device IDs · comma separated; blank uses defaults" Style="{StaticResource Label}"/><TextBox Text="{Binding Devices, UpdateSourceTrigger=PropertyChanged}" ToolTip="Use IDs from Hardware. Leave blank to use your saved recovery device or checked automatic selection."/></StackPanel><StackPanel Grid.Column="2"><TextBlock TextWrapping="Wrap" Text="Temperature abort threshold · °C; optional" Style="{StaticResource Label}"/><TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" ToolTip="Stop recovery if a supported device reaches this temperature. Leave blank to use Hashcat?s default protection."/></StackPanel></Grid>
        <TextBlock TextWrapping="Wrap" Text="Results output · blank creates a separate file per job" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" Command="{Binding BrowseOutputCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
        <TextBlock TextWrapping="Wrap" Text="Potfile · blank uses HashLynx’s local potfile" Style="{StaticResource Label}"/><TextBox Text="{Binding PotfilePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="A potfile remembers recovered passwords so later attempts can skip them. It contains sensitive data and stays on your computer." AutomationProperties.HelpText="The local potfile caches recovered passwords so later attempts can skip them."/><CheckBox Content="Disable potfile for this job" IsChecked="{Binding DisablePotfile}"/>
        <StackPanel Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}"><TextBlock TextWrapping="Wrap" Text="Additional arguments · one argument per line; do not add shell quotes" Style="{StaticResource Label}"/><TextBox Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}" Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/><TextBlock TextWrapping="Wrap" Text="Internally managed options cannot be overridden. Preflight reports conflicts." Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
      </StackPanel></Expander>
    </StackPanel></Border>
    <Border x:Name="ExpertPreflightPanel" Style="{StaticResource Card}" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock TextWrapping="Wrap" Text="Command preview &amp; preflight" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="85" MaxHeight="220" VerticalScrollBarVisibility="Auto"/><TextBlock TextWrapping="Wrap" Text="{Binding Preflight}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,12,0,16"/><WrapPanel><Button Content="Run preflight" Command="{Binding PreflightCommand}"/><Button Content="Copy command" Command="{Binding CopyCommand}"/></WrapPanel></StackPanel></Border>
    <Border x:Name="BasicStart" Style="{StaticResource Card}"><StackPanel><TextBlock TextWrapping="Wrap" Text="{Binding StartFeedback}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/><Button x:Name="StartRecoveryButton" Content="Start recovery →" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/><TextBlock x:Name="RecoveryDeviceSummary" TextWrapping="Wrap" Text="{Binding RecoveryDeviceSummary, Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock TextWrapping="Wrap" Text="Recovery runs locally. You can monitor progress or stop the job on the Jobs page." Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Run several attempts" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Add this configuration to the queue, or build a dictionary sequence that tries your selected wordlist unchanged, then with Quick and Normal rules. Sequences use separate result files and a shared recovery cache." Style="{StaticResource Muted}"/>
      <WrapPanel Margin="0,12,0,0"><Button Content="Add current attack to queue" Command="{Binding AddToQueueCommand}"/><Button Content="Queue No Rules, Quick, Normal" Command="{Binding AddProgressiveSequenceCommand}" Visibility="{Binding IsDictionary, Converter={StaticResource BoolVisibility}}"/></WrapPanel>
      <CheckBox Content="Append current attack to the sequence selected on Queue (same target required)" IsChecked="{Binding AppendToSelectedSequence}"/>
    </StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
