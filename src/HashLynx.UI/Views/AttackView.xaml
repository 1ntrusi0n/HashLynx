<UserControl x:Class="HashLynx.UI.Views.AttackView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:HashLynx.UI.Views" xmlns:infra="clr-namespace:HashLynx.UI.Infrastructure">
  <UserControl.Resources><infra:FileNameConverter x:Key="FileName"/></UserControl.Resources>
  <ScrollViewer x:Name="AttackScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="30,25,30,20">
    <DockPanel><CheckBox DockPanel.Dock="Right" Content="Expert mode" IsChecked="{Binding Expert}"/><TextBlock TextWrapping="Wrap" Text="Build an attack" Style="{StaticResource PageTitle}"/></DockPanel><TextBlock TextWrapping="Wrap" Text="Choose your target, a wordlist, and a rule preset. Start recovery when you're ready." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
    <views:InspectorView DataContext="{Binding Inspector}"/>
    <Border Style="{StaticResource Card}"><StackPanel>
      <DockPanel><TextBlock TextWrapping="Wrap" Text="02" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" Text="Attack configuration" Style="{StaticResource SectionTitle}"/></DockPanel>
      <TextBlock TextWrapping="Wrap" Text="{Binding AttackErrors}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,0,6"/><TabControl SelectedIndex="{Binding Family}"><TabItem Header="Dictionary"/><TabItem Header="Mask"/><TabItem Header="Hybrid"/><TabItem Header="Combinator"/></TabControl>
      <StackPanel Visibility="{Binding IsHybrid, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,10"><TextBlock TextWrapping="Wrap" Text="Hybrid direction" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding HybridDirections}" SelectedIndex="{Binding HybridDirection}"/></StackPanel>
      <StackPanel Visibility="{Binding UsesWordlists, Converter={StaticResource BoolVisibility}}">
        <TextBlock TextWrapping="Wrap" Text="Wordlists · drop files to add them" Style="{StaticResource Label}"/><TextBlock TextWrapping="Wrap" Text="A wordlist is a text file with one starting word per line." Style="{StaticResource Muted}" Margin="0,0,0,7"/>
        <ListBox ItemsSource="{Binding Wordlists}" SelectedItem="{Binding SelectedWordlist}" MinHeight="45" MaxHeight="105" infra:DropFiles.Command="{Binding DropWordlistsCommand}"><ListBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Text="{Binding Converter={StaticResource FileName}}" ToolTip="{Binding}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
        <TextBlock TextWrapping="Wrap" Text="{Binding WordlistSummary}" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
        <WrapPanel Margin="0,10,0,0"><Button Content="{Binding WordlistButtonLabel}" Command="{Binding AddWordlistsCommand}" Margin="0,0,8,8"/><Button Content="Use starter list" Command="{Binding UseStarterCommand}" Margin="0,0,8,8"/><Button Content="Use local full list" Command="{Binding UseLocalWordlistCommand}" Visibility="{Binding HasLocalWordlist, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8"/><Button Content="Remove" Command="{Binding RemoveWordlistCommand}" Margin="0,0,8,8"/><Button Content="↑" ToolTip="Move selected wordlist up" Command="{Binding MoveWordlistUpCommand}" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8"/><Button Content="↓" ToolTip="Move selected wordlist down" Command="{Binding MoveWordlistDownCommand}" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8"/></WrapPanel>
      </StackPanel>
      <StackPanel Visibility="{Binding IsDictionary, Converter={StaticResource BoolVisibility}}">
        <CheckBox Content="Use custom rule files instead of a preset" IsChecked="{Binding UseCustomRules}" Visibility="{Binding ShowCustomRuleChoice, Converter={StaticResource BoolVisibility}}"/>
        <StackPanel x:Name="PresetRules" Visibility="{Binding ShowPresets, Converter={StaticResource BoolVisibility}}">
          <DockPanel Margin="0,10,0,6"><Button Content="?" Command="{Binding ToggleRulesHelpCommand}" ToolTip="What are rules, and which preset should I choose?" AutomationProperties.Name="Explain Dictionary rule presets" DockPanel.Dock="Right" Width="28" Height="28" Padding="0" Margin="8,0,0,0"/><TextBlock TextWrapping="Wrap" Text="Rules preset" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/></DockPanel>
          <ComboBox x:Name="RulesPresetPicker" ItemsSource="{Binding RulePresets}" SelectedItem="{Binding SelectedRulePreset}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Dictionary rules preset"/>
          <TextBlock TextWrapping="Wrap" Text="{Binding PresetSummary}" Margin="0,8,0,4"/><TextBlock TextWrapping="Wrap" Text="{Binding PresetEffort}" Style="{StaticResource Muted}"/>
          <Border x:Name="PresetHelp" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,12,0,0" Visibility="{Binding RulesHelpVisible, Converter={StaticResource BoolVisibility}}"><StackPanel>
            <TextBlock TextWrapping="Wrap" Text="How rules work" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBlock TextWrapping="Wrap" Text="Rules make variations of a word. For example, river can become River or river1. You supply the words; a preset chooses how many kinds of changes to try." FontSize="12"/>
            <TextBlock TextWrapping="Wrap" Text=":       → river&#10;c       → River&#10;$1      → river1&#10;c$1$!   → River1!" FontFamily="Consolas" FontSize="13" Margin="0,10,0,7"/>
            <TextBlock TextWrapping="Wrap" Text="The left side shows Hashcat instruction strings written in rule files. The right side shows their output for the starting word river. Rule files contain instructions, not lists of candidate passwords." Style="{StaticResource Muted}"/>
            <TextBlock TextWrapping="Wrap" Text="Quick — the shortest pass, for common small changes.&#10;Normal — a balanced first try with more variations.&#10;Heavy — broader coverage and a noticeably longer run.&#10;Super — the widest preset and potentially much more time." FontSize="12" Margin="0,12,0,12"/>
            <TextBlock TextWrapping="Wrap" Text="Approximate work = wordlist lines × rule count. Rules can produce duplicate candidates or reject a word, so the count is an upper estimate. Actual time depends on the hash type, hardware, and wordlist. More rules do not guarantee a recovered password." Style="{StaticResource Muted}"/>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="CustomRulesPanel" Visibility="{Binding ShowCustomRules, Converter={StaticResource BoolVisibility}}"><TextBlock TextWrapping="Wrap" Text="Custom rule files" Style="{StaticResource Label}"/><ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" Height="74" infra:DropFiles.Command="{Binding DropRulesCommand}"/><TextBlock TextWrapping="Wrap" Text="With no rule files, Hashcat tries the original words. Multiple rule files combine their transformations and can multiply the work." Style="{StaticResource Muted}" Margin="0,7,0,0"/><WrapPanel Margin="0,10,0,4"><Button Content="Add rules…" Command="{Binding AddRulesCommand}"/><Button Content="Browse Hashcat rules…" Command="{Binding BundledRulesCommand}"/><Button Content="Remove rule" Command="{Binding RemoveRuleCommand}"/></WrapPanel></StackPanel>
        <CheckBox Content="Loopback" IsChecked="{Binding Loopback}" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}" ToolTip="Use recovered plaintext as additional candidates. Dictionary attacks need a preset or rule file for loopback."/>
      </StackPanel>
      <StackPanel Visibility="{Binding UsesMask, Converter={StaticResource BoolVisibility}}">
        <TextBlock TextWrapping="Wrap" Text="Mask" Style="{StaticResource Label}"/><TextBox Text="{Binding Mask, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
        <TextBlock TextWrapping="Wrap" Text="?l lowercase · ?u uppercase · ?d digits · ?h / ?H hex · ?s symbols · ?a printable · ?b bytes · ?? literal ?" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
        <TextBlock TextWrapping="Wrap" Text="Mask file (when set, takes precedence over the mask field)" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Command="{Binding BrowseMaskCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding MaskFile, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
        <WrapPanel VerticalAlignment="Center"><CheckBox Content="Increment length" IsChecked="{Binding Increment}"/><TextBlock TextWrapping="Wrap" Text="Min" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding IncrementMinimum}" Width="50" Margin="0,8,14,0"/><TextBlock TextWrapping="Wrap" Text="Max" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding IncrementMaximum}" Width="50" Margin="0,8,0,0"/></WrapPanel>
        <Expander Header="Custom charsets · reference as ?1, ?2, ?3, ?4"><UniformGrid Columns="2" Margin="0,6,0,0"><StackPanel Margin="0,0,12,0"><TextBlock TextWrapping="Wrap" Text="?1" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset1, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock TextWrapping="Wrap" Text="?2" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock TextWrapping="Wrap" Text="?3" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset3, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock TextWrapping="Wrap" Text="?4" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset4, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></UniformGrid></Expander>
      </StackPanel>
      <StackPanel Visibility="{Binding IsCombinator, Converter={StaticResource BoolVisibility}}">
        <TextBlock TextWrapping="Wrap" Text="Each left word combines with each right word, in that order." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
        <TextBlock TextWrapping="Wrap" Text="Left wordlist" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Command="{Binding BrowseLeftCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding LeftWordlist, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
        <TextBlock TextWrapping="Wrap" Text="+" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,5"/>
        <TextBlock TextWrapping="Wrap" Text="Right wordlist" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Command="{Binding BrowseRightCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding RightWordlist, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
      </StackPanel>
      <Expander Visibility="{Binding UsesSingleRules, Converter={StaticResource BoolVisibility}}" Header="Single left / right rules (supported combinations only)"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="15"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock TextWrapping="Wrap" Text="Left rule expression" Style="{StaticResource Label}"/><TextBox Text="{Binding LeftRule, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hashcat --rule-left expression, for example l to lowercase."/></StackPanel><StackPanel Grid.Column="2"><TextBlock TextWrapping="Wrap" Text="Right rule expression" Style="{StaticResource Label}"/><TextBox Text="{Binding RightRule, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid></Expander>
    </StackPanel></Border>
    <Border x:Name="RunOptionsPanel" Style="{StaticResource Card}" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock TextWrapping="Wrap" Text="Run options" Style="{StaticResource SectionTitle}"/><TextBlock TextWrapping="Wrap" Text="{Binding CommonErrors}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,0,6"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock TextWrapping="Wrap" Text="Session name" Style="{StaticResource Label}"/><TextBox Text="{Binding Session, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock TextWrapping="Wrap" Text="Workload · 1 light → 4 heavy" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Workloads}" SelectedItem="{Binding Workload}"/></StackPanel></Grid>
      <CheckBox Content="Optimized kernels · may limit password length" IsChecked="{Binding OptimizedKernel}"/>
      <Expander Header="Advanced"><StackPanel Margin="0,6,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock TextWrapping="Wrap" Text="Device IDs · comma separated; blank uses defaults" Style="{StaticResource Label}"/><TextBox Text="{Binding Devices, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock TextWrapping="Wrap" Text="Temperature abort threshold · °C; optional" Style="{StaticResource Label}"/><TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
        <TextBlock TextWrapping="Wrap" Text="Results output · blank creates a separate file per job" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse…" Command="{Binding BrowseOutputCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
        <TextBlock TextWrapping="Wrap" Text="Potfile · blank uses HashLynx’s local potfile" Style="{StaticResource Label}"/><TextBox Text="{Binding PotfilePath, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Disable potfile for this job" IsChecked="{Binding DisablePotfile}"/>
        <StackPanel Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}"><TextBlock TextWrapping="Wrap" Text="Additional arguments · one argument per line; do not add shell quotes" Style="{StaticResource Label}"/><TextBox Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}" Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/><TextBlock TextWrapping="Wrap" Text="Internally managed options cannot be overridden. Preflight reports conflicts." Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
      </StackPanel></Expander>
    </StackPanel></Border>
    <Border x:Name="ExpertPreflightPanel" Style="{StaticResource Card}" Visibility="{Binding Expert, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock TextWrapping="Wrap" Text="Command preview &amp; preflight" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="85" MaxHeight="220" VerticalScrollBarVisibility="Auto"/><TextBlock TextWrapping="Wrap" Text="{Binding Preflight}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,12,0,16"/><WrapPanel><Button Content="Run preflight" Command="{Binding PreflightCommand}"/><Button Content="Copy command" Command="{Binding CopyCommand}"/></WrapPanel></StackPanel></Border>
    <Border x:Name="BasicStart" Style="{StaticResource Card}"><StackPanel><TextBlock TextWrapping="Wrap" Text="{Binding StartFeedback}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/><Button x:Name="StartRecoveryButton" Content="Start recovery →" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/><TextBlock x:Name="RecoveryDeviceSummary" TextWrapping="Wrap" Text="{Binding RecoveryDeviceSummary, Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock TextWrapping="Wrap" Text="Recovery runs locally. You can monitor progress or stop the job on the Jobs page." Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
    <Expander Header="Saved attack profiles" Margin="0,0,0,18"><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock TextWrapping="Wrap" Text="Save configuration for another run. Targets and recovered results are excluded." Style="{StaticResource Muted}"/><DockPanel Margin="0,12,0,10"><Button Content="Load" DockPanel.Dock="Right" Command="{Binding LoadProfileCommand}" Margin="8,0"/><Button Content="Delete" DockPanel.Dock="Right" Command="{Binding DeleteProfileCommand}" Margin="0"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"/></DockPanel><DockPanel><Button Content="Save profile" DockPanel.Dock="Right" Command="{Binding SaveProfileCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name your profile"/></DockPanel></StackPanel></Border></Expander>
  </StackPanel></ScrollViewer>
</UserControl>
