<UserControl x:Class="HashLynx.UI.Views.ResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,25,30,20"><TextBlock Text="Results" Style="{StaticResource PageTitle}"/><TextBlock Text="Recovered credentials remain on your computer. Reveal and export them deliberately." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recovered results" Style="{StaticResource SectionTitle}"/><DockPanel><Button Content="Load results" Command="{Binding LoadCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" DisplayMemberPath="Name"/></DockPanel><CheckBox Content="Reveal plaintext passwords" IsChecked="{Binding Reveal}"/><DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" Height="360"><DataGrid.Columns><DataGridTextColumn Header="Hash" Binding="{Binding Hash, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Recovered plaintext" Binding="{Binding Plaintext, Mode=OneWay}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,14,0,16"/><WrapPanel><Button Content="Copy selected plaintext" Command="{Binding CopyCommand}"/><Button Content="Export CSV…" Command="{Binding ExportCommand}"/></WrapPanel></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
