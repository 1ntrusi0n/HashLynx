<UserControl x:Class="HashLynx.UI.Views.ResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,25,30,20"><TextBlock Text="Results" Style="{StaticResource PageTitle}"/><TextBlock Text="See which hashes were recovered and their passwords. Results stay on your computer." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recovered results" Style="{StaticResource SectionTitle}"/><DockPanel><Button Content="Refresh results" Command="{Binding LoadCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><ComboBox x:Name="ResultsSessionPicker" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" DisplayMemberPath="Name"/></DockPanel><CheckBox Content="Show passwords" IsChecked="{Binding Reveal}"/><DataGrid x:Name="RecoveredResultsGrid" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" Height="360"><DataGrid.Columns><DataGridTextColumn Header="Hash" Binding="{Binding Hash, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Password" Binding="{Binding Plaintext, Mode=OneWay}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock TextWrapping="Wrap" Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,14,0,16"/><WrapPanel><Button Content="Copy selected password" Command="{Binding CopyCommand}"/><Button Content="Export CSV…" Command="{Binding ExportCommand}"/></WrapPanel></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
