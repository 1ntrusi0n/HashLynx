<UserControl x:Class="HashLynx.UI.Views.MaskSourcesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Mask source" Style="{StaticResource Label}"/>
    <ComboBox x:Name="MaskSourcePicker" ItemsSource="{Binding MaskSources}" SelectedItem="{Binding SelectedMaskSource}" AutomationProperties.Name="Mask source"/>
    <StackPanel x:Name="BuiltInMasksPanel" Visibility="{Binding IsBuiltInMask, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
      <TextBlock Text="{Binding BuiltInMaskSummary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding BuiltInMaskDescription}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
      <TextBlock Text="Historical corpus-derived patterns; coverage depends on the password." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
      <TextBlock Text="{Binding BuiltInMaskEffort}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,10,0,0"/>
      <TextBlock Text="Hashcat works through the structures in order. Progress and time estimates describe the current structure, not the whole list. A mask list does not guarantee recovery." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel x:Name="CustomMaskTextPanel" Visibility="{Binding ShowMaskText, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Mask" Style="{StaticResource Label}"/>
      <TextBox x:Name="CustomMaskText" Text="{Binding Mask, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="Custom password mask"/>
      <TextBlock Text="?l lowercase · ?u uppercase · ?d digits · ?h / ?H hex · ?s symbols · ?a printable · ?b bytes · ?? literal ?" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel x:Name="CustomMaskFilePanel" Visibility="{Binding ShowMaskFile, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Your mask file" Style="{StaticResource Label}"/>
      <DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Command="{Binding BrowseMaskCommand}" Margin="8,0,0,0"/><TextBox x:Name="CustomMaskFile" Text="{Binding MaskFile, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom mask file path"/></DockPanel>
      <TextBlock Text="Choose an existing .hcmask file with one mask per line. This source uses only the selected file." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel x:Name="CustomMaskOptionsPanel" Visibility="{Binding UsesCustomMaskOptions, Converter={StaticResource BoolVisibility}}">
      <WrapPanel VerticalAlignment="Center"><CheckBox Content="Increment length" IsChecked="{Binding Increment}"/><TextBlock Text="Min" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding IncrementMinimum}" Width="50" Margin="0,8,14,0"/><TextBlock Text="Max" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding IncrementMaximum}" Width="50" Margin="0,8,0,0"/></WrapPanel>
      <Expander Header="Custom charsets · reference as ?1, ?2, ?3, ?4"><UniformGrid Columns="2" Margin="0,6,0,0"><StackPanel Margin="0,0,12,0"><TextBlock Text="?1" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset1, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="?2" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="?3" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset3, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="?4" Style="{StaticResource Label}"/><TextBox Text="{Binding Charset4, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></UniformGrid></Expander>
    </StackPanel>
    <TextBlock Text="Hybrid attacks append or prepend this pattern to each word. The built-in list contains complete password structures and is available on the Mask tab." Visibility="{Binding IsHybrid, Converter={StaticResource BoolVisibility}}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
    <Expander Header="What is a mask?" Margin="0,10,0,0"><StackPanel Margin="0,7,0,0">
      <TextBlock Text="A mask describes character types and fixed text, rather than words. Hashcat tries every combination that matches it." TextWrapping="Wrap" Style="{StaticResource Muted}"/>
      <TextBlock Text="?d?d?d?d → 0000 through 9999 (10,000 candidates)&#10;?u?l?l?d → Aaa0, Aaa1, …, Zzz9&#10;Summer?d?d! → Summer00! through Summer99!" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <TextBlock Text="Each additional position multiplies the work. Choose a focused custom pattern if you remember part of the password, or use the hints wizard above." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
    </StackPanel></Expander>
  </StackPanel>
</UserControl>
