<UserControl x:Class="HashLynx.UI.Views.HardwareView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,25,30,20"><DockPanel><Button Content="Refresh devices" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="10,0,0,0"/><TextBlock Text="Hardware" Style="{StaticResource PageTitle}"/></DockPanel><TextBlock Text="Compute devices reported by the configured Hashcat backend." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Backend devices" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,0,0,16"/><ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}"><Run Text="Device "/><Run Text="{Binding Id}"/></TextBlock><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/></DockPanel><UniformGrid Columns="2" Margin="0,14,0,0"><StackPanel><TextBlock Text="BACKEND / API" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Backend}" Margin="0,5,0,12"/><TextBlock Text="TYPE" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Type}" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="MEMORY" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Memory}" Margin="0,5,0,12"/><TextBlock Text="DRIVER" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Driver}" Margin="0,5,0,0"/></StackPanel></UniformGrid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
