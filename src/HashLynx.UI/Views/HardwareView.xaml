<UserControl x:Class="HashLynx.UI.Views.HardwareView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="30,25,30,20">
      <DockPanel>
        <Button Content="Refresh devices" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="10,0,0,0"/>
        <TextBlock TextWrapping="Wrap" Text="Hardware" Style="{StaticResource PageTitle}"/>
      </DockPanel>
      <TextBlock TextWrapping="Wrap" Text="Choose a compute device and check that it can run a sample recovery." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" Text="Test my hardware" Style="{StaticResource SectionTitle}"/>
          <TextBlock x:Name="HardwareCheckStatus" Text="{Binding TestStatus}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <ProgressBar IsIndeterminate="True" Visibility="{Binding IsTesting, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12"/>
          <Button Content="Cancel check" Command="{Binding CancelTestCommand}" HorizontalAlignment="Left" Visibility="{Binding IsTesting, Converter={StaticResource BoolVisibility}}"/>
          <TextBlock TextWrapping="Wrap" Text="A passed check verifies a small sample on that device. It does not benchmark every format or change your recovery default." Style="{StaticResource Muted}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" Text="Backend devices" Style="{StaticResource SectionTitle}"/>
          <TextBlock x:Name="DefaultDeviceSummary" Text="{Binding DefaultSummary, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Button Content="Use automatic selection" Command="{Binding AutomaticCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
          <TextBlock TextWrapping="Wrap" Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
          <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock TextWrapping="Wrap" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}"><Run Text="Device "/><Run Text="{Binding Id, Mode=OneWay}"/></TextBlock>
                      <TextBlock TextWrapping="Wrap" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                    </DockPanel>
                    <UniformGrid Columns="2" Margin="0,14,0,0">
                      <StackPanel><TextBlock TextWrapping="Wrap" Text="BACKEND / API" Style="{StaticResource Muted}"/><TextBlock TextWrapping="Wrap" Text="{Binding Backend}" Margin="0,5,0,12"/><TextBlock TextWrapping="Wrap" Text="TYPE" Style="{StaticResource Muted}"/><TextBlock TextWrapping="Wrap" Text="{Binding Type}" Margin="0,5,0,0"/></StackPanel>
                      <StackPanel><TextBlock TextWrapping="Wrap" Text="MEMORY" Style="{StaticResource Muted}"/><TextBlock TextWrapping="Wrap" Text="{Binding Memory}" Margin="0,5,0,12"/><TextBlock TextWrapping="Wrap" Text="DRIVER" Style="{StaticResource Muted}"/><TextBlock TextWrapping="Wrap" Text="{Binding Driver}" Margin="0,5,0,0"/></StackPanel>
                    </UniformGrid>
                    <WrapPanel Margin="0,16,0,0">
                      <Button x:Name="TestHardwareDeviceButton" Content="Test recovery on this device" Command="{Binding DataContext.TestDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                      <Button x:Name="UseDefaultDeviceButton" Content="Use this device by default" Command="{Binding DataContext.UseDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
