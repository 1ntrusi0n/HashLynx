<UserControl x:Class="HashLynx.UI.Views.InspectorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:infra="clr-namespace:HashLynx.UI.Infrastructure">
  <Border Style="{StaticResource Card}" infra:DropFiles.Command="{Binding DropCommand}"><StackPanel>
    <DockPanel><TextBlock TextWrapping="Wrap" Text="01" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" Text="Target Inspector" Style="{StaticResource SectionTitle}"/></DockPanel>
    <TextBlock TextWrapping="Wrap" Text="{Binding ValidationMessage}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,0,6"/><TabControl SelectedIndex="{Binding InputMode}">
      <TabItem Header="Paste Hash" ToolTip="A hash is a stored password fingerprint. Paste the fingerprint here; choose Encrypted File for a document or archive."><StackPanel><TextBlock TextWrapping="Wrap" Text="Hash to identify" Style="{StaticResource Label}"/><TextBox Text="{Binding HashText, UpdateSourceTrigger=PropertyChanged}" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></TabItem>
      <TabItem Header="Hash File"><StackPanel><TextBlock TextWrapping="Wrap" Text="Browse or drop a hash file here. Your source stays unchanged." Style="{StaticResource Label}"/><DockPanel><Button Content="Browse&#x2026;" DockPanel.Dock="Right" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel></TabItem>
      <TabItem Header="Encrypted File" ToolTip="Select your encrypted file. HashLynx extracts the data Hashcat needs locally and keeps the original file unchanged."><StackPanel><TextBlock TextWrapping="Wrap" Text="Choose an encrypted Office document, PDF, KeePass database, archive, or partition image." Style="{StaticResource Label}"/><DockPanel><Button Content="Browse&#x2026;" DockPanel.Dock="Right" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock TextWrapping="Wrap" Text="Supported formats are built in. Extraction notes explain format limitations." Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></TabItem>
      <TabItem Header="BitLocker Drive"><StackPanel>
        <TextBlock TextWrapping="Wrap" Text="Read password-recovery metadata directly from a connected BitLocker volume." Style="{StaticResource Label}"/>
        <DockPanel><Button Content="Refresh drives" DockPanel.Dock="Right" Command="{Binding RefreshDrivesCommand}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="DisplayName" MinWidth="200"/></DockPanel>
        <TextBlock Text="{Binding DriveStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock Text="Windows will request administrator permission for the read-only extractor. Ordinary unlock passwords are supported; TPM, startup PINs and recovery keys are not." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Button Content="Cancel drive read" Command="{Binding CancelDriveCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
      </StackPanel></TabItem>
    </TabControl>
    <Grid x:Name="SourceContextControls" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock TextWrapping="Wrap" Text="Source / context" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Contexts}" SelectedItem="{Binding Context}"/></StackPanel><Button Grid.Column="2" Content="{Binding AnalyzeButtonText}" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0"/></Grid>
    <StackPanel x:Name="ExtractedHashPanel" Visibility="{Binding HasExtractedHash, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
      <TextBlock x:Name="ExtractedHashLabel" Text="{Binding ExtractedHashLabel, Mode=OneWay}" Style="{StaticResource Label}"/>
      <TextBox x:Name="ExtractedHashText" Text="{Binding ExtractedHashPreview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" MinHeight="72" MaxHeight="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" AutomationProperties.Name="{Binding ExtractedHashLabel}" AutomationProperties.HelpText="Select and copy the displayed hash. Use Copy full hash for all records, including long hashes shown as a preview." ToolTip="This is the password-recovery hash extracted from your encrypted file or volume. Copy full hash copies every extracted record, even when a long hash is shown as a preview."/>
      <TextBlock Text="{Binding ExtractedHashDisplayNotice, Mode=OneWay}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <Button x:Name="CopyExtractedHashButton" Content="Copy full hash" Command="{Binding CopyExtractedHashCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Copy every extracted hash record, including any text beyond the visible preview."/>
    </StackPanel>
    <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="13"><TextBlock TextWrapping="Wrap" Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></Border>
    <TextBlock x:Name="ExtractionNotice" Text="{Binding ExtractionNotice}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,10,0,0"/><Style.Triggers><DataTrigger Binding="{Binding ExtractionNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <ListBox ItemsSource="{Binding Matches}" SelectedItem="{Binding SelectedMatch}" MaxHeight="150" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock TextWrapping="Wrap" Text="{Binding Mode}" Width="65" Foreground="{DynamicResource AccentBrush}"/><StackPanel><TextBlock TextWrapping="Wrap" Text="{Binding Name}"/><TextBlock TextWrapping="Wrap" Text="{Binding Category}" Style="{StaticResource Muted}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBlock TextWrapping="Wrap" Text="{Binding SelectedMode.DisplayName, TargetNullValue=No hash mode selected, FallbackValue=No hash mode selected}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,12,0,0"/>
    <Expander x:Name="ManualModeExpander" Header="Manual mode selection &#xB7; searchable installed catalog" ToolTip="A mode identifies the encryption or hash algorithm. Similar-looking hashes can match several algorithms; your source helps choose the correct one." IsExpanded="False"><StackPanel Margin="0,10,0,0"><DockPanel><Button Content="Refresh catalog" DockPanel.Dock="Right" Command="{Binding RefreshCatalogCommand}" Margin="8,0,0,0"/><TextBox x:Name="ManualModeSearch" AutomationProperties.HelpText="Search the installed Hashcat catalog by algorithm name, number or category. Choose the type that matches the source." Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by mode number, name or category"/></DockPanel><ListBox x:Name="ManualModeList" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedCatalogMode}" Height="160" Margin="0,8,0,0"><ListBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap"><Run Text="{Binding DisplayName, Mode=OneWay}"/><Run Text="  &#xB7;  "/><Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Expander>
    <Expander Header="Problem lines"><TextBox Text="{Binding Problems, Mode=OneWay}" IsReadOnly="True" MaxHeight="180" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,10,0,0"/></Expander>
  </StackPanel></Border>
</UserControl>
