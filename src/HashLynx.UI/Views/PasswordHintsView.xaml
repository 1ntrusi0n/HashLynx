<UserControl x:Class="HashLynx.UI.Views.PasswordHintsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="0,12,0,0">
    <TextBlock Text="Start with any remembered words, or describe a known beginning and ending with unknown characters in between. Attempts use the target selected above." TextWrapping="Wrap" Style="{StaticResource Muted}"/>
    <TextBlock TextWrapping="Wrap" Text="Remembered words or phrases - one per line (optional)" Style="{StaticResource Label}"/>
    <TextBox x:Name="HintWords" Text="{Binding Words, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="85" VerticalScrollBarVisibility="Auto" MaxLength="32768"/>
    <CheckBox Content="Also try Quick and Normal rule variations of these words" IsChecked="{Binding TryVariations}"/>
    <CheckBox Content="I remember a pattern or approximate length" IsChecked="{Binding UsePattern}"/>
    <StackPanel Visibility="{Binding UsePattern, Converter={StaticResource BoolVisibility}}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock TextWrapping="Wrap" Text="Known beginning (optional)" Style="{StaticResource Label}"/><TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock TextWrapping="Wrap" Text="Known ending (optional)" Style="{StaticResource Label}"/><TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"/></StackPanel>
      </Grid>
      <TextBlock TextWrapping="Wrap" Text="Try these characters in the unknown middle" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding CharacterChoices}" SelectedItem="{Binding Characters}"/>
      <WrapPanel><TextBlock TextWrapping="Wrap" Text="Total length from" VerticalAlignment="Center"/><TextBox Text="{Binding MinimumLength, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="10,8"/><TextBlock TextWrapping="Wrap" Text="to" VerticalAlignment="Center"/><TextBox Text="{Binding MaximumLength, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="10,8"/></WrapPanel>
      <TextBlock TextWrapping="Wrap" Text="Example: beginning Summer, ending !, total length 11, digits in the middle tries Summer0000! through Summer9999!. For an optional ending, add a second sequence without it. Pattern text supports printable ASCII; remembered words can contain Unicode." Style="{StaticResource Muted}"/>
    </StackPanel>
    <Button Content="Preview attempts" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" Margin="0,14,0,10"/>
    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Steps}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <Expander Header="Example candidates (shown only here)"><TextBox Text="{Binding Examples, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" MinHeight="45" MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/></Expander>
    <Button x:Name="QueueHintsButton" Content="Add these attempts to queue" Command="{Binding QueueCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,10"/>
    <TextBlock TextWrapping="Wrap" Text="The queue starts only when you choose Start queue. Remembered words are saved locally as a candidate file for these attempts." Style="{StaticResource Muted}"/>
  </StackPanel>
</UserControl>
